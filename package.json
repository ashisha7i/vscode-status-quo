{
  "name": "status-bar-customizer",
  "icon": "images/icon.png",
  "displayName": "Color My Status",
  "description": "Show custom text in the status bar and change the status bar color.",
  "version": "0.1.0",
  "publisher": "ashisha7i",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ashisha7i/vscode-color-my-status"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "statusBarCustomizer.editText",
        "title": "Color My Status: Edit Text"
      },
      {
        "command": "statusBarCustomizer.changeColor",
        "title": "Color My Status: Change Color"
      }
    ],
    "configuration": {
      "title": "Color My Status",
      "properties": {
        "statusBarCustomizer.text": {
          "type": "string",
          "default": "Click to edit",
          "description": "The text shown in the status bar. Saved in the current project (workspace) settings.",
          "scope": "window"
        }
      }
    }
  }
}
