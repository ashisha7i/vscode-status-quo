{
  "name": "status-quo",
  "icon": "images/icon.png",
  "displayName": "Status Quo",
  "description": "Show custom text in the status bar and change the status bar color.",
  "version": "0.0.2",
  "publisher": "ashisha7i",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ashisha7i/vscode-status-quo"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "statusQuo.editText",
        "title": "Status Quo: Edit Text"
      },
      {
        "command": "statusQuo.changeColor",
        "title": "Status Quo: Change Color"
      }
    ],
    "configuration": {
      "title": "Status Quo",
      "properties": {
        "statusQuo.text": {
          "type": "string",
          "default": "Click to edit",
          "description": "The text shown in the status bar. Saved in the current project (workspace) settings.",
          "scope": "window"
        }
      }
    }
  }
}
